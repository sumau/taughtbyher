  "scripts": {
    "dev": "vite --config vite.config.ts --host 0.0.0.0",
    "build": "vite build --config vite.config.ts",
    "analyze:bundle": "pnpm run build && node ./scripts/analyze-bundle.mjs",
    "verify:css": "node ./scripts/verify-css-build.mjs",
    "serve": "vite preview --config vite.config.ts --host 0.0.0.0",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "pnpm --filter @workspace/api-server exec tsx --tsconfig ../welltutored/tsconfig.json --test-concurrency=1 --test ../welltutored/src/app/route-map.test.ts ../welltutored/src/components/layout/WorkspaceAuthBoundary.test.tsx ../welltutored/src/components/EnquiryForm.test.tsx ../welltutored/src/lib/public-tutor-query.test.ts ../welltutored/src/pages/TutorProfile.test.tsx ../welltutored/src/pages/Home.test.tsx"
  },
